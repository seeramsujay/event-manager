# Copy to .env and fill in with your Gemini Flash Lite API key.
# Without a key the app still works and serves curated ideas.
GEMINI_API_KEY=

# Optional: Override the default model (defaults to gemini-2.0-flash-lite)
# GEMINI_MODEL=gemini-2.0-flash-lite

# Optional server configuration:
# PORT=3000
# HOST=127.0.0.1
# RATE_LIMIT_PER_MINUTE=20
# Only behind a reverse proxy that appends X-Forwarded-For:
# TRUST_PROXY=true

# Backward-compatibility fallback:
# ANTHROPIC_API_KEY=
